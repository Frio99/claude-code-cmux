#!/bin/bash

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# --- 弹窗报错 ---
alert() {
    osascript -e "display alert \"Claude Code Cmux\" message \"$1\" as warning"
    exit 1
}

# --- 获取目标目录 ---
TARGET_DIR="$1"
if [ -z "$TARGET_DIR" ]; then
    TARGET_DIR=$(osascript -e '
        tell application "Finder"
            try
                POSIX path of (target of front window as alias)
            on error
                ""
            end try
        end tell
    ')
fi
[ -z "$TARGET_DIR" ] && TARGET_DIR="$HOME"

# --- 检查目录是否存在 ---
[ ! -d "$TARGET_DIR" ] && alert "目录不存在: $TARGET_DIR"

# --- 找 claude 路径 ---
# Finder 启动的 App 拿不到终端里的 PATH，所以先查常见位置，再用登录 shell 兜底
CLAUDE_PATH=""
for p in "$HOME/.local/bin/claude" /opt/homebrew/bin/claude /usr/local/bin/claude \
         "$HOME/.npm-global/bin/claude" "$HOME/.claude/local/claude" \
         "$HOME"/.nvm/versions/node/*/bin/claude "$HOME"/.volta/bin/claude \
         "$HOME"/Library/pnpm/claude "$HOME"/.bun/bin/claude; do
    [ -x "$p" ] && CLAUDE_PATH="$p" && break
done
if [ -z "$CLAUDE_PATH" ]; then
    LOGIN_SHELL="${SHELL:-/bin/zsh}"
    p=$("$LOGIN_SHELL" -lic 'command -v claude' 2>/dev/null | tail -1)
    [ -n "$p" ] && [ -x "$p" ] && CLAUDE_PATH="$p"
fi
[ -z "$CLAUDE_PATH" ] && alert "找不到 Claude Code CLI\n\n请在终端运行安装:\ncurl -fsSL https://claude.ai/install.sh | bash\n\n装好后在终端输入 claude 确认能启动，再点一次本工具。"

# --- 检查 cmux 是否已安装 ---
[ ! -d "/Applications/cmux.app" ] && alert "找不到 cmux\n\n请先安装: https://cmux.com"

# --- 找 cmux CLI ---
CMUX_CLI="/Applications/cmux.app/Contents/Resources/bin/cmux"
[ ! -x "$CMUX_CLI" ] && alert "找不到 cmux CLI\n\n请先安装: https://cmux.com"

# --- 检查 cmux 是否允许本工具连接 ---
# 只引导，不替用户改安全设置，也不退出 cmux（会中断正在运行的任务）。
# 「自动化模式」就够用，而且在 cmux 设置里改完立即生效。
if ! "$CMUX_CLI" ping >/dev/null 2>&1; then
    CURRENT_MODE=$(defaults read com.cmuxterm.app socketControlMode 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr -d '_-')
    case "$CURRENT_MODE" in
        ""|cmuxonly|off)
            CHOICE=$(osascript -e 'button returned of (display alert "需要先在 cmux 里开启自动化模式" message "只需设置一次：

1. 在 cmux 中按 ⌘, 打开设置
2. 进入「自动化」(Automation)
3. 把「套接字控制模式」(Socket Control Mode) 改为「自动化模式」(Automation mode)
4. 回到访达，再点一次本工具

此模式允许你这个 macOS 账号下的其他程序控制 cmux。无需重启，不影响正在运行的任务。" buttons {"以后再说", "打开 cmux"} default button "打开 cmux")')
            [ "$CHOICE" = "打开 cmux" ] && open -a cmux
            exit 0
            ;;
    esac
fi

# --- 确保 cmux 运行并激活 ---
CMUX_WAS_RUNNING=$(osascript -e 'application "cmux" is running')
open -a cmux

# 等 cmux socket 就绪（最多 15s）
for i in $(seq 1 30); do
    "$CMUX_CLI" ping >/dev/null 2>&1 && break
    sleep 0.5
done
"$CMUX_CLI" ping >/dev/null 2>&1 || alert "连不上 cmux\n\n请确认 cmux 已打开，且「设置 → 自动化 → 套接字控制模式」为「自动化模式」，然后重试。"

# --- 创建 workspace 并启动 claude ---
WORKSPACE_NAME="Claude Code: $(basename "$TARGET_DIR")"

if [ "$CMUX_WAS_RUNNING" != "true" ]; then
    DEFAULT_WS=$("$CMUX_CLI" list-workspaces 2>/dev/null | head -1 | awk '{for(i=1;i<=NF;i++) if($i ~ /^workspace:/) {print $i; exit}}')
fi

NEW_WS=$("$CMUX_CLI" new-workspace --name "$WORKSPACE_NAME" --cwd "$TARGET_DIR" --command "'${CLAUDE_PATH}' --dangerously-skip-permissions")
NEW_WS="${NEW_WS#OK }"
"$CMUX_CLI" select-workspace --workspace "$NEW_WS"

if [ -n "$DEFAULT_WS" ]; then
    "$CMUX_CLI" close-workspace --workspace "$DEFAULT_WS" 2>/dev/null
fi
